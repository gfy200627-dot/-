# ============================================================
# AutoInsight 开发环境变量
# ============================================================

# 真实后端地址（FastAPI 默认 http://127.0.0.1:8000）
VITE_API_BASE_URL=/api

# 是否启用前端 Mock 数据服务：true = 使用 src/mock，false = 请求真实后端
VITE_USE_MOCK=true

# Mock 模拟网络延迟（毫秒）
VITE_MOCK_DELAY=260

# 平台名称
VITE_APP_TITLE=AutoInsight
